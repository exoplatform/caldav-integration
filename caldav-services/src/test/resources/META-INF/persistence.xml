<?xml version="1.0" encoding="UTF-8"?>
<!--
  A persistence unit that exists for the tests alone.

  The platform builds its EntityManager from jpa-entities.idx and a shared
  configuration this module never sees, so nothing in the unit suite could run
  a JPQL string through the engine that will run it in production. That is the
  gap RepositoryQueryContractTest can only half close: it reads the queries as
  text. This unit lets one test execute them.

  It lists the same four entities jpa-entities.idx registers, and nothing else.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="caldav-test" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>org.exoplatform.caldav.entity.CaldavServerEntity</class>
    <class>org.exoplatform.caldav.entity.CaldavCalendarSyncEntity</class>
    <class>org.exoplatform.caldav.entity.CaldavObjectSyncEntity</class>
    <class>org.exoplatform.caldav.entity.CaldavPendingPushEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.hsqldb.jdbc.JDBCDriver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:hsqldb:mem:caldav-jpql;shutdown=true"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
