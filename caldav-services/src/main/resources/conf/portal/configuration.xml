<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd http://www.exoplatform.org/xml/ns/kernel_1_3.xsd" xmlns="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd">
  <component>
    <type>org.exoplatform.caldav.rest.CaldavConnectorRest</type>
  </component>
  <component>
    <type>org.exoplatform.caldav.storage.CaldavConnectorStorage</type>
  </component>
  <component>
    <key>org.exoplatform.caldav.service.CaldavConnectorService</key>
    <type>org.exoplatform.caldav.service.CaldavConnectorServiceImpl</type>
  </component>

  <!-- FileService namespace the uploaded server images are written under.
       Without it, writeFile NPEs on an unknown namespace: the FileService
       only accepts writes into declared namespaces, and declaring one is a
       kernel plugin — email-connector's EmailConnectorNameSpacePlugin is the
       model this copies. -->
  <external-component-plugins>
    <target-component>org.exoplatform.commons.file.services.NameSpaceService</target-component>
    <component-plugin>
      <name>CaldavServerNameSpacePlugin</name>
      <set-method>addNameSpacePlugin</set-method>
      <type>org.exoplatform.commons.file.services.NameSpacePlugin</type>
      <init-params>
        <properties-param>
          <name>fileNameSpace.params</name>
          <property name="name" value="caldavServer" />
          <property name="description" value="caldav server images" />
        </properties-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.calendar.created</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.CalendarCreatedListener</type>
      <description>Pushes a newly created calendar to the user's CalDAV server without waiting for the throttled sync</description>
    </component-plugin>
  </external-component-plugins>
  <!-- A rename is the edit that shows: the collection eXo created for a
       personal calendar reads under the calendar's name, and until EXO-89528
       that name was written once, inside MKCALENDAR, and never again. -->
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.calendar.updated</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.CalendarUpdatedListener</type>
      <description>Carries a calendar's new name to its collection on the user's CalDAV server without waiting for the throttled sync</description>
    </component-plugin>
  </external-component-plugins>
  <!-- The outward half of answering a meeting. Bound to responseSaved rather
       than responseSent: the copy has to track what agenda holds, which
       includes the reset to NEEDS-ACTION after a material edit and the
       propagation of an answer onto a series' exceptional occurrences —
       neither of which is "sent" by a user. -->
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.event.responseSaved</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.EventResponseSavedListener</type>
      <description>Carries an answer recorded in eXo out to the copy on the user's CalDAV server, so the two never diverge</description>
    </component-plugin>
  </external-component-plugins>
  <!-- The first thing that ever happens to a meeting, which until EXO-89754
       reached nothing at all: the three registrations below all react to a
       meeting that already exists. A new event therefore only acquired a copy
       when somebody edited or answered it, or when the background seeding pass
       happened to find it inside its 60-day upcoming window — so a meeting
       further out, or created in the past, was never copied by anything.

       exo.agenda.event.created only. A date poll is broadcast under
       exo.agenda.event.poll.created and is spelled STATUS:TENTATIVE; it is not
       a scheduled meeting and no copy of one is ever pushed. -->
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.event.created</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.EventCreatedListener</type>
      <description>Copies a newly created meeting into the calendar of everybody invited to it, without waiting for the sweep</description>
    </component-plugin>
  </external-component-plugins>
  <!-- An edit reaching everyone's calendar, not only the editor's. Before
       these two, the only push of an event was the one the editing user's own
       browser made, so an organiser who moved a meeting moved it on their own
       phone and on nobody else's.

       exo.agenda.event.updated is the only modification agenda broadcasts for
       an existing meeting, and it carries the cancellation too: cancelling is
       an update that sets the status, and the copy is rewritten with
       STATUS:CANCELLED. exo.agenda.event.deleted is separate because it is
       broadcast after the event row is gone — nothing is left to render, so
       the copy is removed instead. Neither ever creates a copy: only somebody
       who already has one is written to. -->
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.event.updated</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.EventUpdatedListener</type>
      <description>Rewrites the calendar copy every attendee already holds when a meeting is edited or cancelled in eXo</description>
    </component-plugin>
  </external-component-plugins>
  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>exo.agenda.event.deleted</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.caldav.listener.EventDeletedListener</type>
      <description>Removes the calendar copy every attendee already holds when a meeting is deleted in eXo</description>
    </component-plugin>
  </external-component-plugins>

</configuration>
