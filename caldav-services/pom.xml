<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.addons.caldav</groupId>
    <artifactId>caldav-parent</artifactId>
    <version>7.3.x-ai-contribution-SNAPSHOT</version>
  </parent>
  <artifactId>caldav-services</artifactId>
  <name>eXo Caldav - Services</name>
  <properties>
    <exo.test.coverage.ratio>0</exo.test.coverage.ratio>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.exoplatform.agenda</groupId>
      <artifactId>agenda-services</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.exoplatform.agenda</groupId>
      <artifactId>agenda-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>caldav-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-service</artifactId>
       <scope>provided</scope>
    </dependency>
    <!--
      ical4j builds an EMAIL parameter through commons-validator, and declares
      it optional — so nothing brought it onto the platform. Any client that
      writes EMAIL= on an attendee line, which Apple Calendar does whenever
      somebody answers an invitation, then made the whole object unparseable
      with a NoClassDefFoundError. Declared here because this add-on is the one
      that parses iCalendar written by other people's clients.

      Still declared although IcsCompatibility now switches ical4j's relaxed
      validation on, which is what stops that constructor calling the validator
      at all (EXO-89820): the hint is a runtime setting and the dependency is
      the floor under it, so a build that removed this would break the moment
      anything turned the hint back off.
    -->
    <dependency>
      <groupId>commons-validator</groupId>
      <artifactId>commons-validator</artifactId>
      <version>1.7</version>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>caldav-services</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} ${env.MAVEN_OPTS} --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.time=ALL-UNNAMED  --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens java.xml/jdk.xml.internal=ALL-UNNAMED </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
