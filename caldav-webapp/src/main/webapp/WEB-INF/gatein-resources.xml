    <supported-locale>zh_TW</supported-locale>
     <script>
       <minify>false</minify>
       <path>/js/caldav.bundle.js</path>
       <!--
         Without this the connector's own strings never reach the pages it runs
         on. It renders inside agenda's apps, so its keys are not in the portal
         i18n those pages carry, and every lookup answers empty: the deletion
         dialog asked the user to confirm and told them nothing.
       -->
       <resource-bundle>locale.portlet.Caldav</resource-bundle>
      </script>
      <depends>
        <module>extensionRegistry</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>vue</module>
