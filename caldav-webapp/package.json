{
  "name": "exo-caldav",
  "version": "1.0.0",
  "description": "eXo Caldav Integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/exoplatform/caldav-integration"
  },
  "scripts": {
    "watch": "webpack --config webpack.watch.js --progress --color --watch",
    "lint": "eslint --fix \"./src/main/webapp/vue-app/**\"",
    "eslint-check": "eslint  \"./src/main/webapp/vue-app/**\"",
    "build": "webpack --config webpack.prod.js --mode production",
    "test": "jest"
  },
  "author": "eXo",
  "license": "LGPL",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.2.4",
    "eslint": "^8.12.0",
    "eslint-config-meedsio": "^1.0.5",
    "eslint-plugin-vue": "^8.6.0",
    "eslint-plugin-vuejs-accessibility": "^2.1.0",
    "eslint-webpack-plugin": "^3.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jwt-decode": "^3.1.2",
    "vue": "^2.6.14",
    "vue-loader": "^15.9.8",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.9.2",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "string_decoder": "^1.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src/test/js"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
