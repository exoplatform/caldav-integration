<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>addons-exo-parent-pom</artifactId>
    <groupId>org.exoplatform.addons</groupId>
    <version>21-M02</version>
  </parent>
  <groupId>org.exoplatform.addons.caldav</groupId>
  <artifactId>caldav-parent</artifactId>
  <version>7.3.x-maintenance-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>eXo Caldav - Parent POM</name>
  <modules>
    <module>caldav-api</module>
    <module>caldav-services</module>
    <module>caldav-webapp</module>
    <module>caldav-packaging</module>
  </modules>
  <scm>
    <connection>scm:git:git://github.com/exoplatform/caldav-integration.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/exoplatform/caldav-integration.git</developerConnection>
    <url>https://github.com/exoplatform/caldav-integration</url>
    <tag>HEAD</tag>
  </scm>
  <properties>
    <!-- Java 25: compile for and against Java 25, with the tools that read its class files -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.release>25</maven.compiler.release>
    <version.jacoco.plugin>0.8.14</version.jacoco.plugin>
    <plugin.aspectj.version>1.16.1</plugin.aspectj.version>
    <org.aspectj.version>1.9.25.1</org.aspectj.version>
    <org.lombok.version>1.18.46</org.lombok.version>
    <!-- 3rd party libraries versions -->
    <addon.exo.agenda.version>7.3.x-maintenance-SNAPSHOT</addon.exo.agenda.version>
    <org.exoplatform.commons-exo.version>7.3.x-maintenance-SNAPSHOT</org.exoplatform.commons-exo.version>
    <!-- The mail reader's calendar-invitation SPI this add-on implements (EXO-90848); provided, never shipped -->
    <addon.exo.email-connector.version>7.3.x-maintenance-SNAPSHOT</addon.exo.email-connector.version>    
    <!-- Sonar properties -->
    <sonar.organization>exoplatform</sonar.organization>

  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.exoplatform.agenda</groupId>
        <artifactId>agenda-parent</artifactId>
        <version>${addon.exo.agenda.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.exoplatform.commons-exo</groupId>
        <artifactId>commons-exo</artifactId>
        <version>${org.exoplatform.commons-exo.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.exoplatform.addons.email-connector</groupId>
        <artifactId>email-connector-services</artifactId>
        <version>${addon.exo.email-connector.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Current project artifacts -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>caldav-api</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>caldav-services</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>caldav-webapp</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
        <type>war</type>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>caldav-packaging</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
        <type>zip</type>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Since JDK 23, javac runs an annotation processor found on the class path, such as Lombok, only when asked to -->
            <proc>full</proc>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <!-- This profile is used to allow github action to build branches. The github action is used for sonar analysis -->
  <profiles>
    <profile>
      <id>project-repositories</id>
      <activation>
        <property>
          <name>!skip-project-repositories</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
          <id>repository.exoplatform.org</id>
          <url>https://repository.exoplatform.org/public</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
          <id>repository.exoplatform.org</id>
          <url>https://repository.exoplatform.org/public</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</project>
